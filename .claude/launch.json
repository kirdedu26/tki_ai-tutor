{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-c",
        "import os,http.server,socketserver; socketserver.TCPServer.allow_reuse_address=True; p=int(os.environ.get('PORT','5055')); socketserver.TCPServer(('',p),http.server.SimpleHTTPRequestHandler).serve_forever()"
      ],
      "autoPort": true,
      "port": 5055
    }
  ]
}
